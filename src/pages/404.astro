---
import Layout from '../layouts/Layout.astro';
import { languageNames, languages, pathFor, ui } from '../lib/i18n';
const t = ui.en;
---
<Layout language="en" section="home" title={t.notFound} description={t.notFoundIntro} noindex>
  <section class="page-intro not-found">
    <p class="eyebrow">404</p>
    <h1>{t.notFound}<span class="accent">.</span></h1>
    <p class="page-lead">{t.notFoundIntro}</p>
    <a class="text-link" href="/">{t.returnHome}<span aria-hidden="true"> →</span></a>
    <nav aria-label={t.languages} class="not-found-languages">{languages.map((language) => <a href={pathFor(language)} lang={language}>{languageNames[language]}</a>)}</nav>
  </section>
</Layout>

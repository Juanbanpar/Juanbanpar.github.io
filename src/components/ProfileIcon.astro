    <circle cx="5" cy="5" r="2.2" />
    <path d="M10 9h3.8v1.6c.8-1.2 1.9-1.9 3.6-1.9 3.2 0 3.6 2.2 3.6 5.1V21h-4v-6.5c0-1.6-.3-2.5-1.5-2.5-1.4 0-1.5 1.1-1.5 2.5V21h-4Z" />
  </>}
  {name === 'orcid' && <>
    <circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5" />
    <circle cx="7.1" cy="7.2" r="1" />
    <path d="M6.3 9.4h1.6v7.2H6.3Z" />
    <path d="M10.2 9.4h2.5a3.6 3.6 0 0 1 0 7.2h-2.5Z" fill="none" stroke="currentColor" stroke-width="1.5" />
